# Copy to .env and fill in. Bun loads .env automatically; Docker Compose reads
# the same file for the container's environment.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the app listens on inside the container.
MAIL_PORT=4040

# Mark session cookies Secure. Set to true whenever the app is served over
# HTTPS (i.e. any real deployment behind a TLS proxy). Leave false for plain
# http://localhost development, or you won't be able to log in.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Postgres connection string. Tables are created automatically on first boot.
# If the password contains special characters, URL-encode them.
# With the bundled compose.yml, `db` is the Postgres service's hostname.
DATABASE_URL=postgres://mailbox:change-me-strong@db:5432/mailbox

# Password for the Postgres container in compose.yml. Must match the password
# in DATABASE_URL above. Ignored if you point DATABASE_URL at your own server.
POSTGRES_PASSWORD=change-me-strong

# ---------------------------------------------------------------------------
# Resend (required)
# ---------------------------------------------------------------------------

# API key from https://resend.com/api-keys — needs sending + receiving access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret for the inbound webhook, from the endpoint you create at
# https://resend.com/webhooks pointing at https://your.host/webhook/inbound
# with the `email.received` event enabled. Without it inbound mail is rejected.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Fallback From address(es), comma-separated. Used to seed the send-from list
# on first boot; after that the list is managed in the app's Settings page.
# The domain must be verified in Resend.
SEND_FROM=you@example.com

# ---------------------------------------------------------------------------
# Mail domain and users
# ---------------------------------------------------------------------------
# These seed the ownership table on first boot only. Afterwards, reservations
# are edited by an admin in the app's Settings page and these are ignored.

# The domain you receive mail on. Every user automatically owns
# <their-username>@MAIL_DOMAIN.
MAIL_DOMAIN=example.com

# Usernames (as they come from your identity provider) who get admin rights:
# they can see all mail and reserve extra addresses for other users.
# Comma-separated.
ADMIN_USERS=alice

# Mail to an address nobody has reserved lands in this user's inbox.
# Defaults to the first entry in ADMIN_USERS if unset.
CATCH_ALL_USER=alice

# ---------------------------------------------------------------------------
# OIDC single sign-on (required) — e.g. Pocket ID, Authentik, Keycloak
# ---------------------------------------------------------------------------

# Issuer URL, no trailing slash. Its /.well-known/openid-configuration must be
# reachable from inside the container.
OIDC_ISSUER=https://id.example.com

OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Must match the callback URL registered with your provider exactly.
OIDC_REDIRECT_URI=https://mail.example.com/auth/callback

# Where the provider sends the browser after a logout.
OIDC_POST_LOGOUT_REDIRECT_URI=https://mail.example.com/login

# Scopes requested at login. The default is enough for username + email.
OIDC_SCOPE=openid profile email

# ---------------------------------------------------------------------------
# Web Push notifications (optional)
# ---------------------------------------------------------------------------
# Leave blank to disable push; the app runs fine without it.
# Generate a keypair with:  bunx web-push generate-vapid-keys

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address for your push subscriptions, as a mailto: URL.
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Legacy migration (optional)
# ---------------------------------------------------------------------------
# Only used by `bun run migrate`, which imports an older JSON-file data
# directory into Postgres. New installs can ignore this.
# DATA_DIR=./data
